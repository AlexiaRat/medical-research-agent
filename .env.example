# ============================================================
# Required
# ============================================================

# Anthropic API key. Used by the planner and the final synthesizer.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI API key. Used for embedding paper abstracts so we can retrieve
# the most relevant passages for a given question (RAG).
# Free tier: 50M tokens/month, more than enough for this demo.
# Get one at https://www.voyageai.com (sign in, then dashboard -> API keys)
VOYAGE_API_KEY=pa-...

# ============================================================
# Optional but recommended
# ============================================================

# NCBI / PubMed API key. Without one, PubMed rate-limits you to 3 req/sec.
# With one, you get 10 req/sec.
# Get one for free at https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# Email used for PubMed E-utilities (NCBI etiquette: lets them contact you
# if they see heavy or anomalous usage from your IP).
NCBI_TOOL_EMAIL=your.email@example.com
